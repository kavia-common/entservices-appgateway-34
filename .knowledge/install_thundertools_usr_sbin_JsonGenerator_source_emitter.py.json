{"is_source_file": true, "format": "Python", "description": "This file defines an Emitter class responsible for generating code or text output with formatting features such as indentation, line wrapping, and line buffering. It manages writing output to a file, handling indentation levels, and line length constraints, and provides methods to write lines, manage indentation, and flush output to disk.", "external_files": [], "external_methods": [], "published": ["Emitter"], "classes": [{"name": "Emitter", "description": "A class that manages formatted code or text emission to a file, supporting indentation, line wrapping, and output buffering."}], "methods": [{"name": "__init__(self, file_name, indent_size, max_line_length = 160)", "description": "Constructor that initializes the emitter with a filename, indentation size, and optional maximum line length.", "scope": "Emitter", "scopeKind": "class"}, {"name": "__del__(self)", "description": "Destructor placeholder, does nothing explicitly.", "scope": "Emitter", "scopeKind": "class"}, {"name": "__enter__(self)", "description": "Enables use of the class with a context manager (enter).", "scope": "Emitter", "scopeKind": "class"}, {"name": "__exit__(self, exc_type, exc_value, traceback)", "description": "Handles cleanup after a context manager block, flushing buffers and closing the output file.", "scope": "Emitter", "scopeKind": "class"}, {"name": "Line(self, text = \"\")", "description": "Adds a line of text to the buffer, handling wrapping based on the line length threshold.", "scope": "Emitter", "scopeKind": "class"}, {"name": "Indent(self)", "description": "Increases indentation level by the specified indent size.", "scope": "Emitter", "scopeKind": "class"}, {"name": "Unindent(self)", "description": "Decreases indentation level, ensuring it does not go below zero.", "scope": "Emitter", "scopeKind": "class"}, {"name": "Prepend(self, other)", "description": "Adds lines from another Emitter's buffer before its own.", "sco