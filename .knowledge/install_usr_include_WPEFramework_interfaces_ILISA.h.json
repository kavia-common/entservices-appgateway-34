{"is_source_file": true, "format": "C++ header", "description": "This file defines the ILISA interface along with several nested interfaces related to application management, storage, metadata, notifications, and versioning. It specifies a framework for handling application installation, uninstallation, resource management, and metadata through a set of virtual methods, facilitating extensibility and external notifications within the WPEFramework environment.", "external_files": ["Module.h"], "external_methods": [], "published": ["ILISA", "ILISA::IStorage", "ILISA::IStoragePayload", "ILISA::IKeyValue", "ILISA::IKeyValueIterator", "ILISA::IMetadataPayload", "ILISA::IAppVersion", "ILISA::IApp", "ILISA::IAppsPayload", "ILISA::IHandleResult", "ILISA::ILockInfo", "ILISA::INotification"], "classes": [{"name": "ILISA", "description": "Main interface for application lifecycle and storage management."}, {"name": "ILISA::IStorage", "description": "Interface for storage path and quota information."}, {"name": "ILISA::IStoragePayload", "description": "Interface for retrieving storage details related to applications and persistent data."}, {"name": "ILISA::IKeyValue", "description": "Key-value pair interface."}, {"name": "ILISA::IKeyValueIterator", "description": "Iterator for traversing key-value pairs."}, {"name": "ILISA::IMetadataPayload", "description": "Interface for application metadata including name, category, URL, resources, and auxiliary metadata."}, {"name": "ILISA::IAppVersion", "description": "Interface to access application version details."}, {"name": "ILISA::IApp", "description": "Interface representing an application with type, ID, and version iterations."}, {"name": "ILISA::IAppsPayload", "description": "Container for a list of applications."}, {"name": "ILISA::IHandleResult", "description": "Interface for obtaining a handle string after locking an application."}, {"name": "ILISA::ILockInfo", "description": "Interface providing lock reason and owner information."}, {"name": "ILISA::INotification", "description": "Interface for receiving asynchronous operation status updates."}], "methods": [{"name": "Install", "description": "Downloads and installs an application bundle based on provided parameters."}, {"name": "Uninstall", "description": "Uninstalls the specified application."}, {"name": "Download", "description": "Downloads an arbitrary resource file associated with an application."}, {"name": "Reset", "description": "Deletes persistent local data for a specific application."}, {"name": "GetStorageDetails", "description": "Retrieves detailed storage usage information."}, {"name": "SetAuxMetadata", "description": "Sets a metadata key-value pair for an application."}, {"name": "ClearAuxMetadata", "description": "Clears a specified auxiliary metadata key."}, {"name": "GetMetadata", "description": "Retrieves application metadata."}, {"name": "Cancel", "description": "Cancels an ongoing request identified by handle."}, {"name": "GetProgress", "description": "Retrieves the progress percentage of a request."}, {"name": "Register", "description": "Registers a notification callback for asynchronous events."}, {"name": "Unregister", "description": "Unregisters a previously registered notification callback."}, {"name": "Configure", "description": "Applies configuration settings to the ILISA instance."}, {"name": "Version", "description": "Retrieves application version string."}, {"name": "AppName", "description": "Retrieves the application name."}, {"name": "Category", "description": "Retrieves the category of the application."}, {"name": "Url", "description": "Retrieves the URL associated with the application."}, {"name": "Type", "description": "Retrieves the type of the application."}, {"name": "Id", "description": "Retrieves the ID of the application."}, {"name": "Installed", "description": "Provides an iterator over application versions installed."}, {"name": "Apps", "description": "Provides an iterator over applications."}, {