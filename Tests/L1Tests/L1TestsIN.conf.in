# L1TestsIN config template used by WPEFramework ConfigGenerator during CMake configure.
# This file is intentionally minimal: the test plugin is a shared library loaded by the
# test harness, and it does not require plugin-specific runtime configuration.
#
# The ConfigGenerator will substitute @locator@ and @classname@ when generating the final
# JSON config for the plugin.

locator=@locator@
classname=@classname@
